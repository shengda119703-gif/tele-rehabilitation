{
  "name": "route1-health-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Ankang Runtime / ProductService for the PySide6 rehabilitation product",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node -e \"const fs=require('node:fs');fs.mkdirSync('.test-build/tests/corpus',{recursive:true});fs.writeFileSync('.test-build/package.json',JSON.stringify({type:'commonjs'}));fs.copyFileSync('tests/corpus/utterances.json','.test-build/tests/corpus/utterances.json')\" && node --test .test-build/tests/*.test.js",
    "build": "npm run typecheck && npm run build:bridge",
    "build:bridge": "node scripts/build-agent-bridge.cjs",
    "format": "npx --yes prettier@3.5.3 --write .",
    "format:check": "npx --yes prettier@3.5.3 --check .",
    "security:check": "node scripts/security-check.mjs",
    "verify:llm": "node scripts/verify-llm-understanding.mjs",
    "proxy": "node scripts/local-llm-proxy.mjs",
    "ci": "npm run build && npm test && npm run test:product && npm run security:check",
    "test:product": "npm run build:bridge && node --test tests/product-desktop.test.cjs tests/product-extensions.test.cjs",
    "healthkit:bridge": "node scripts/healthkit-bridge.mjs",
    "test:healthkit": "node scripts/test-healthkit.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.63.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2"
}
